# Variables de entorno para desarrollo local
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local a git

# Supabase — obtén estos valores en supabase.com → tu proyecto → Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# VPS Nexaro (a configurar cuando esté listo el backend)
# Solo la URL: el token de autorización ya NO es una clave estática, se
# obtiene dinámicamente por sesión vía la Edge Function nexaro-token
# (ver odontix-src/src/lib/nexaro.ts y supabase/functions/nexaro-token/)
# VITE_NEXARO_URL=https://api.odontix.eu
